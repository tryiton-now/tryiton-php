{
  "name": "tryiton/tryiton",
  "description": "Official PHP SDK for the TryItOn virtual try-on API.",
  "type": "library",
  "license": "MIT",
  "keywords": ["tryiton", "virtual-try-on", "tryon", "fashion", "ai", "sdk"],
  "homepage": "https://docs.tryiton.now",
  "support": {
    "docs": "https://docs.tryiton.now",
    "source": "https://github.com/tryiton-now/tryiton-php",
    "issues": "https://github.com/tryiton-now/tryiton-php/issues"
  },
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "TryItOn\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TryItOn\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress"
  },
  "config": {
    "sort-packages": true
  }
}
